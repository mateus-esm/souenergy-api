# ─────────────────────────────────────────────────────────────────────────────
# SouEnergy API — configuração (SOLO NOMES/PLACEHOLDERS, NUNCA valores reais)
# Copiar a `.env` (fora do checkout, modo 0600) e preencher com os segredos.
# Nenhun valor real deve ser versionado neste repositório.
# ─────────────────────────────────────────────────────────────────────────────

# Credenciales do site SouEnergy (login do scraper)
USUARIO=
SENHA=

# Chave da API (obrigatoria — a API falha na inicialização se ausente/vazia)
API_KEY=

# ─── Base de dados ────────────────────────────────────────────────────────────
SOUENERGY_DB=/var/lib/souenergy/catalogo.sqlite3
DB_BUSY_TIMEOUT_MS=30000

# ─── Catálogo ─────────────────────────────────────────────────────────────────
# Entradas do catálogo: lista separada por ";" de "nome|url|marca".
# Se vazio, usa as entradas padrão de config/entradas_catalogo.json.
CATALOGO_ENTRADAS=

# ─── Exportação / publicação ──────────────────────────────────────────────────
# Diretório onde se escreve precios.json candidato (validación local)
EXPORT_DIR=./solo-prices
# Repo de propostas-soloenergia (checkout local; o publicador clona e faz push
# ao remoto `origin` desse checkout, com credencial de máquina restringida)
REPO_PROPUESTAS=/srv/solo-dev/repos/propostas-soloenergia
REPO_PROPUESTAS_BRANCH=master
# Publicação automática após coleta aprovada (true/false)
PUBLICAR_AUTOMATICAMENTE=false

# ─── Alertas (canal opcional; sem canal só loga) ──────────────────────────────
ALERTA_WEBHOOK_URL=
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT_ID=

# ─── Deploy VPS (SSH por clave — sem contraseña embebida) ────────────────────
VPS_HOST=
VPS_PORT=22
VPS_USER=
VPS_SSH_KEY=
VPS_KNOWN_HOSTS=

# ─── Límites de coleta ────────────────────────────────────────────────────────
LIMITE_PAGINAS=200
LIMITE_TIEMPO_MIN=60
# Variación de precio que dispara alerta de revisión operacional (porcentaje)
VARIACION_MAXIMA_PCT=30