[Unit]
Description=Coleta completa SouEnergy — disparo diario 04:30 America/Sao_Paulo
Documentation=docs/dev/projects/souenergy-api/SE-PRICES-002/codex/plano.md

[Timer]
# Timezone explícito (systemd >= 244). Verificar con: systemd-analyze calendar
OnCalendar=*-*-* 04:30:00 America/Sao_Paulo
# Recupera un disparo perdido, sin ejecutar todo el historial de días perdidos
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target